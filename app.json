{
  "expo": {
    "name": "SıfırNoktası",
    "slug": "sifirnoktasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F7FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sifirnoktasi.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0F7FF"
      },
      "package": "com.sifirnoktasi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "SıfırNoktası",
      "shortName": "SıfırNoktası",
      "themeColor": "#E8F4FD",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "baseUrl": "/sifirnoktasi/app"
    },
    "plugins": [
      "expo-notifications",
      "expo-asset"
    ]
  }
}
